{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "exampleproducer"
  ],
  "ios": {
    "iosModuleName": "ExampleProducer"
  },
  "android": {
    "androidNamespace": [
      "exampleproducer"
    ],
    "androidCxxLibName": "ExampleProducer"
  },
  "autolinking": {
    "ExampleProducer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridExampleProducer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridExampleProducer"
      }
    },
    "BenchProducer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBenchProducer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBenchProducer"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
