{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "eventstream"
  ],
  "ios": {
    "iosModuleName": "EventStream"
  },
  "android": {
    "androidNamespace": [
      "eventstream"
    ],
    "androidCxxLibName": "EventStream"
  },
  "autolinking": {
    "EventQueue": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridEventQueue"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridEventQueue"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "example"
  ]
}
